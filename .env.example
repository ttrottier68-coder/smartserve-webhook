# ===== Server =====
PORT=5000

# ===== Google Sheets =====
# The ID from your Google Sheet URL (the long string between /d/ and /edit)
GOOGLE_SHEET_ID=your_sheet_id_here
# The tab name (defaults to "Sheet1")
GOOGLE_SHEET_TAB=Sheet1

# Google service account credentials as a single-line JSON string
# To get this: Google Cloud Console → IAM & Admin → Service Accounts →
# Create service account → Create key (JSON) → paste the contents here
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# ===== Email (Gmail SMTP by default) =====
EMAIL_ENABLED=true
EMAIL_FROM=leads@smartserve.cloud
EMAIL_TO=ttrottier68@gmail.com

# Gmail SMTP (use an app password, not your account password)
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=leads@smartserve.cloud
SMTP_PASS=your_gmail_app_password
